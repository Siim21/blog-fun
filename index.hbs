{{!< default}}

<div class="home-layout">

    <aside class="home-sidebar">

      <div class="home-profile-image"></div>

      <div class="home-panel">
        <div class="about-panel-title">About me</div>
        <div class="home-panel-body">
          <p>Bold text, italic text, link... your about blurb.</p>
        </div>
      </div>

      {{#get "posts" limit="1" page=pagination.page}}
        {{#foreach posts}}
          <article class="post-summary-card">
            <div class="post-summary-title">{{title}}</div>
            <div class="post-summary-body">
              <span class="gh-card-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
              </span>
              <p>{{excerpt words="15"}}</p>
              <a class="post-summary-link" href="{{url}}">Read more</a>
            </div>
          </article>
        {{/foreach}}
      {{/get}}

    </aside>

    <div class="home-posts">
      <div class="gh-postfeed">
        {{#get "posts" limit="4" page=pagination.page offset="1"}}
          {{#foreach posts}}
            <article class="post-summary-card">
              <div class="post-summary-title">{{title}}</div>
              <div class="post-summary-body">
                <span class="gh-card-meta">
                  <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
                </span>
                <p>{{excerpt words="15"}}</p>
                <a class="post-summary-link" href="{{url}}">Read more</a>
              </div>
            </article>
          {{/foreach}}
        {{/get}}
      </div>
          <div class="gh-pagination">
      {{pagination}}
    </div>
    </div>


</div>
