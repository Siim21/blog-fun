{{!< default}}

<div class="content-box">
  <div class="main">

    <aside class="sidebar">

      <div class="profile-pic"></div>

      <div class="box">
        <div class="box-title">Title here</div>
        <div class="box-body">
          <p>Bold text, italic text, link... your about blurb.</p>
        </div>
      </div>

      {{#get "posts" limit="1" page=pagination.page}}
        {{#foreach posts}}
          <article class="box">
            <div class="box-title">{{title}}</div>
            <div class="box-body">
              <span class="gh-card-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
              </span>
              <p>{{excerpt words="15"}}</p>
              <a class="read-more" href="{{url}}">Read more</a>
            </div>
          </article>
        {{/foreach}}
      {{/get}}

    </aside>

    <div class="content">
      <div class="gh-postfeed">
        {{#get "posts" limit="4" page=pagination.page offset="1"}}
          {{#foreach posts}}
            <article class="box">
              <div class="box-title">{{title}}</div>
              <div class="box-body">
                <span class="gh-card-meta">
                  <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
                </span>
                <p>{{excerpt words="15"}}</p>
                <a class="read-more" href="{{url}}">Read more</a>
              </div>
            </article>
          {{/foreach}}
        {{/get}}
      </div>
          <div class="gh-pagination">
      {{pagination}}
    </div>
    </div>


  </div>
</div>